<diagram id="tekino-layered" name="Layered Architecture">
<mxGraphModel dx="1500" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="presentation" value="1. Presentation Layer | لایه نمایش&lt;br&gt;Customer Web UI · Admin Dashboard · Product Pages · Cart · Checkout&lt;br&gt;Collects input and displays results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="100" width="950" height="145" as="geometry"/></mxCell>
<mxCell id="application" value="2. Application Layer | لایه کاربرد&lt;br&gt;SearchProductsUseCase · UpdateCartUseCase · CheckoutUseCase · Admin Use Cases&lt;br&gt;Coordinates workflows and invokes domain behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="950" height="145" as="geometry"/></mxCell>
<mxCell id="domain" value="3. Domain / Business Layer | لایه دامنه و کسب‌وکار&lt;br&gt;Product · Cart · Order · Inventory · Payment Rules · Domain Services&lt;br&gt;Owns business rules and policies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="500" width="950" height="145" as="geometry"/></mxCell>
<mxCell id="infrastructure" value="4. Infrastructure Layer | لایه زیرساخت&lt;br&gt;Repository Implementations · Database Adapter · Payment Gateway Adapter&lt;br&gt;Implements technical details and external integrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="950" height="145" as="geometry"/></mxCell>
<mxCell id="external" value="External Systems&lt;br&gt;Payment Provider&lt;br&gt;Email / Delivery (future)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1150" y="520" width="250" height="155" as="geometry"/></mxCell>
